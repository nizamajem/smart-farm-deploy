# ===== Sumber kode =====
# Repo private: pakai SSH (git@github.com:...) dengan deploy key, atau HTTPS + token.
BACKEND_REPO=https://github.com/nizamajem/smart-farm-backend.git
FRONTEND_REPO=https://github.com/nizamajem/smart-farm-frontend.git
BRANCH=main

# ===== Jaringan =====
# ":80" = HTTP biasa via IP server. Isi domain (mis. farm.contoh.com) untuk HTTPS otomatis.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Cloudflare Tunnel (opsional). Isi lewat: ./deploy.sh tunnel <TOKEN>
# Saat memakai tunnel, biarkan SITE_ADDRESS=:80 (HTTPS ditangani Cloudflare).
CLOUDFLARE_TUNNEL_TOKEN=
# URL API yang dipakai web (relatif ke domain yang sama)
PUBLIC_API_URL=/api
CORS_ORIGINS=

# ===== Backend =====
# Kosongkan JWT_SECRET & ADMIN_PASSWORD: deploy.sh akan membuatkan nilai acak saat pertama kali.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin awal, hanya dibuat bila database belum punya akun
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartfarm.local
ADMIN_PASSWORD=

# true = isi akun & perangkat demo (hanya bila ADMIN_EMAIL/ADMIN_PASSWORD kosong)
SEED_DEMO=false

# ===== Home Assistant (opsional) =====
# URL HA tanpa /api. Harus bisa dijangkau dari server (IP LAN/publik; "homeassistant.local" tidak bisa dari container).
HA_BASE_URL=
# Profil HA → Security → Long-lived access tokens → Create token
HA_TOKEN=
HA_SYNC_INTERVAL_SEC=300
HA_SYNC_ENABLED=true

# ===== MQTT (jalur data langsung dari perangkat) =====
# Saklar awal; setelahnya diatur dari web admin → Integrasi
MQTT_ENABLED=true
# Port TCP di server untuk perangkat (MQTT polos, LAN). Dari luar LAN pakai wss://<domain>/api/mqtt
MQTT_TCP_PORT=1883
# Alamat server yang ditampilkan ke tim HW (kosong = diisi otomatis IP LAN server oleh deploy.sh)
MQTT_PUBLIC_HOST=
# Akun pemantau untuk tim HW (boleh subscribe smartfarm/#). Password kosong = dibuat acak oleh deploy.sh
MQTT_ADMIN_USERNAME=hwteam
MQTT_ADMIN_PASSWORD=

# Jumlah backup database yang disimpan
BACKUP_KEEP=10
