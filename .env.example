# ===== Sumber kode =====
# Repo private: pakai SSH (git@github.com:...) dengan deploy key, atau HTTPS + token.
BACKEND_REPO=https://github.com/nizamajem/smart-farm-backend.git
FRONTEND_REPO=https://github.com/nizamajem/smart-farm-frontend.git
BRANCH=main

# ===== Jaringan =====
# ":80" = HTTP biasa via IP server. Isi domain (mis. farm.contoh.com) untuk HTTPS otomatis.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# URL API yang dipakai web (relatif ke domain yang sama)
PUBLIC_API_URL=/api
CORS_ORIGINS=

# ===== Backend =====
# Kosongkan JWT_SECRET & ADMIN_PASSWORD: deploy.sh akan membuatkan nilai acak saat pertama kali.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin awal, hanya dibuat bila database belum punya akun
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartfarm.local
ADMIN_PASSWORD=

# true = isi akun & perangkat demo (hanya bila ADMIN_EMAIL/ADMIN_PASSWORD kosong)
SEED_DEMO=false

# Jumlah backup database yang disimpan
BACKUP_KEEP=10
